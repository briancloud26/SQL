  <script>
    lucide.createIcons();

    const canvas = document.getElementById('canvas');
    const sqlPreview = document.getElementById('sqlPreview');
    const copyBtn = document.getElementById('copyBtn');
    const exportBtn = document.getElementById('exportBtn');
    const addTableBtn = document.getElementById('addTableBtn');
    let customCount = 2;

    const staticTables = [
      {
        name: 'users',
        columns: [
          ['id','UUID PRIMARY KEY'],
          ['full_name','TEXT NOT NULL'],
          ['email','TEXT UNIQUE NOT NULL'],
          ['created_at','TIMESTAMP DEFAULT NOW()']
        ]
      },
      {
        name: 'orders',
        columns: [
          ['id','UUID PRIMARY KEY'],
          ['user_id','UUID REFERENCES users(id)'],
          ['total_amount','INTEGER NOT NULL'],
          ['created_at','TIMESTAMP DEFAULT NOW()']
        ]
      }
    ];

    const dynamicTables = [];

    function makeSql() {
      const all = [...staticTables, ...dynamicTables];
      return all.map(table => {
        const cols = table.columns.map(([name, type]) => `  ${name} ${type}`).join(',\n');
        return `CREATE TABLE ${table.name} (\n${cols}\n);`;
      }).join('\n\n');
    }

    function renderSql(){
      sqlPreview.textContent = makeSql();
    }

    function createDynamicTable(name){
      const index = dynamicTables.length;
      const x = 120 + (index % 2) * 290;
      const y = 430 + Math.floor(index / 2) * 190;
      const table = {
        name,
        columns: [
          ['id','UUID PRIMARY KEY'],
          ['name','TEXT NOT NULL'],
          ['created_at','TIMESTAMP DEFAULT NOW()']
        ]
      };
      dynamicTables.push(table);

      const article = document.createElement('article');
      article.className = 'table-card absolute bg-white rounded-2xl overflow-hidden z-10';
      article.style.left = x + 'px';
      article.style.top = y + 'px';
      article.style.width = '235px';
      article.dataset.dynamicName = name;

      article.innerHTML = `
        <div class="px-4 py-3 bg-[#3e705f] text-white flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center"><i data-lucide="table-2" class="w-4 h-4"></i></span>
            <h3 class="font-semibold text-sm">${name}</h3>
          </div>
          <button class="delete-table text-white/80 hover:text-white focus-ring" aria-label="Delete ${name}"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="divide-y divide-[#edf1ed]">
          <div class="px-4 py-3 flex items-center justify-between">
            <div><div class="text-sm font-semibold text-[#24483a]">id</div><div class="text-[11px] text-[#879189] mt-0.5">UUID</div></div>
            <span class="px-2 py-1 rounded-md bg-[#fff3d8] text-[#9a6d17] text-[10px] font-semibold">PK</span>
          </div>
          <div class="px-4 py-3">
            <div class="text-sm font-semibold text-[#24483a]">name</div><div class="text-[11px] text-[#879189] mt-0.5">TEXT</div>
          </div>
          <div class="px-4 py-3">
            <div class="text-sm font-semibold text-[#24483a]">created_at</div><div class="text-[11px] text-[#879189] mt-0.5">TIMESTAMP</div>
          </div>
        </div>
      `;

      article.querySelector('.delete-table').addEventListener('click', () => {
        const idx = dynamicTables.findIndex(t => t.name === name);
        if (idx >= 0) dynamicTables.splice(idx, 1);
        article.remove();
        renderSql();
      });

      canvas.appendChild(article);
      lucide.createIcons();
      renderSql();
    }

    addTableBtn.addEventListener('click', () => {
      customCount += 1;
      createDynamicTable(`table_${customCount}`);
    });

    document.querySelectorAll('.entity-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        customCount += 1;
        const entity = btn.dataset.entity || 'table';
        createDynamicTable(`${entity}_${customCount}`);
      });
    });

    copyBtn.addEventListener('click', async () => {
      const original = copyBtn.innerHTML;
      try {
        await navigator.clipboard.writeText(makeSql());
        copyBtn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Copied</span>';
        lucide.createIcons();
        setTimeout(() => {
          copyBtn.innerHTML = original;
          lucide.createIcons();
        }, 1400);
      } catch (e) {
        copyBtn.innerHTML = '<i data-lucide="x" class="w-4 h-4"></i><span>Failed</span>';
        lucide.createIcons();
        setTimeout(() => {
          copyBtn.innerHTML = original;
          lucide.createIcons();
        }, 1400);
      }
    });

    exportBtn.addEventListener('click', () => {
      const blob = new Blob([makeSql()], { type: 'text/sql' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'schema.sql';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    renderSql();
  </script>
