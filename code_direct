<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile Directory</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#18211d;
      --muted:#6d746f;
      --paper:#f4f1ea;
      --line:#d8d2c7;
      --forest:#173f31;
      --forest-2:#2a6550;
      --cream:#fbfaf6;
      --sage:#dde8dc;
      --sand:#eee3d2;
      --bluegrey:#e6eaec;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:'DM Sans',sans-serif;color:var(--ink);min-width:320px}
    .display-font{font-family:'Fraunces',serif}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 84% 8%, rgba(210,222,211,.62), transparent 24%),
        radial-gradient(circle at 7% 15%, rgba(255,255,255,.82), transparent 20%),
        linear-gradient(135deg,#f7f4ed 0%,#eee8dd 100%);
    }
    .noise{
      background-image:radial-gradient(rgba(23,33,28,.035) 1px,transparent 1px);
      background-size:18px 18px;
    }
    .glass-card{
      background:rgba(251,250,246,.92);
      backdrop-filter:blur(14px);
      border:1px solid rgba(216,210,199,.9);
      box-shadow:0 18px 52px rgba(31,41,35,.075);
    }
    .focus-ring:focus-visible{outline:3px solid rgba(37,88,70,.28);outline-offset:2px}
    .metric-card{transition:transform .25s ease, box-shadow .25s ease}
    .metric-card:hover{transform:translateY(-3px);box-shadow:0 22px 58px rgba(31,41,35,.11)}
    .profile-card{transition:transform .25s ease, box-shadow .25s ease}
    .profile-card:hover{transform:translateY(-4px);box-shadow:0 22px 58px rgba(31,41,35,.11)}
    .row-enter{animation:rowIn .28s ease both}
    @keyframes rowIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    .avatar-fallback{
      background:linear-gradient(135deg,#dbe7dd,#edf2ea);
      color:#244c3b;
    }
  </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 <script src="/_sdk/telemetry_sdk.js"></script></head>
 <body data-template-id="__page-root" style="background: linear-gradient(135deg, rgb(247, 244, 237), rgb(239, 233, 222));">
  <div class="app-shell noise w-full">
   <header class="w-full px-5 sm:px-8 lg:px-10 pt-8 lg:pt-10">
    <div class="max-w-7xl mx-auto">
     <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div>
       <p data-template-id="hero-kicker" class="canva-text uppercase tracking-[0.22em] text-xs font-semibold mb-3" style="color: rgb(109, 119, 111); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.18rem;">People / Directory</p>
       <h1 data-template-id="directory-title" class="canva-text display-font leading-[1.03] max-w-4xl" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 54px; line-height: 1.02;">A considered place for every person.</h1>
       <p data-template-id="directory-subtitle" class="canva-text mt-4 max-w-2xl leading-7" style="color: rgb(102, 113, 105); font-weight: 400; font-style: normal; font-size: 17px; line-height: 1.6;">Keep your team, collaborators and community contacts beautifully organized in one living directory.</p>
      </div>
      <div data-template-id="directory-badge" class="canva-tag inline-flex items-center gap-2 rounded-full border border-[#cfd8cf] bg-[#eef4ed] px-4 py-2 text-sm font-semibold text-[#315c49] self-start lg:self-auto" style="background: rgb(238, 244, 237); color: rgb(49, 92, 73); font-weight: 700; font-style: normal; font-size: 15px;">Live profile directory</div>
     </div>
    </div>
   </header>
   <main class="w-full px-5 sm:px-8 lg:px-10 pb-10">
    <div class="max-w-7xl mx-auto">
     <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mt-10" aria-label="Directory summary">
      <article data-template-id="metric-card-1" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-total-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Total people</p>
         <p id="metric-total" class="display-font text-3xl mt-3 text-[#173f31]">0</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e1eadf] flex items-center justify-center text-[#255846]"><i data-lucide="users" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-2" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-roles-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Distinct roles</p>
         <p id="metric-roles" class="display-font text-3xl mt-3 text-[#173f31]">0</p>
        </div><span class="w-10 h-10 rounded-full bg-[#eee3d2] flex items-center justify-center text-[#8a693e]"><i data-lucide="briefcase-business" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-3" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-newest-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Newest profile</p>
         <p id="metric-newest" class="display-font text-2xl mt-3 text-[#173f31] truncate max-w-[170px]">—</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e4e1ee] flex items-center justify-center text-[#675a86]"><i data-lucide="sparkles" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-4" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-visible-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Visible now</p>
         <p id="metric-visible" class="display-font text-3xl mt-3 text-[#173f31]">0</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e6eaec] flex items-center justify-center text-[#566a72]"><i data-lucide="search-check" class="w-5 h-5"></i></span>
       </div>
      </article>
     </section>
     <section class="grid grid-cols-1 xl:grid-cols-[1.45fr_.75fr] gap-6 mt-6">
      <section data-template-id="directory-panel" class="canva-panel glass-card rounded-[28px] overflow-hidden" style="background: rgb(251, 250, 246);">
       <div class="p-5 sm:p-6 lg:p-7 border-b border-[#ded7cb]">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
         <div>
          <h2 data-template-id="directory-section-title" class="canva-text display-font" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 23px;">People directory</h2>
          <p data-template-id="directory-section-subtitle" class="canva-text mt-2" style="color: rgb(115, 123, 117); font-weight: 400; font-style: normal; font-size: 14px;">Search, review and manage every profile in one calm workspace.</p>
         </div>
         <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
          <div class="w-full sm:w-72"><label data-template-id="search-label" for="search-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Search</label>
           <div class="relative"><i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-[#7e877f]"></i> <input id="search-input" data-template-id="search-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] pl-10 pr-3 py-3 text-sm outline-none transition" type="text" placeholder="Name, email or role" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
           </div>
          </div>
          <div class="self-end"><button id="add-profile-button" data-template-id="add-profile-button" class="canva-button focus-ring inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold transition" type="button" style="background: rgb(23, 63, 49); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 15px;">Add profile</button>
          </div>
         </div>
        </div>
       </div>
       <div id="empty-state" class="hidden px-6 py-16 text-center">
        <div class="w-14 h-14 rounded-full bg-[#e6ecdf] flex items-center justify-center mx-auto text-[#255846]">
         <i data-lucide="users-round" class="w-6 h-6"></i>
        </div>
        <h3 data-template-id="empty-state-title" class="canva-text display-font mt-5" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 18px;">No profiles found</h3>
        <p data-template-id="empty-state-copy" class="canva-text mt-2 max-w-md mx-auto" style="color: rgb(115, 123, 117); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.5;">Try a different search, or add someone new to begin building your directory.</p>
       </div>
       <div id="profile-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 p-5 sm:p-6 lg:p-7"></div>
      </section>
      <aside data-template-id="form-panel" class="canva-panel glass-card rounded-[28px] p-5 sm:p-6 lg:p-7" style="background: rgb(251, 250, 246);">
       <p data-template-id="form-kicker" class="canva-text uppercase tracking-[0.18em] text-[11px] font-semibold mb-3" style="color: rgb(124, 133, 126); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.16rem;">Directory editor</p>
       <h2 data-template-id="form-title" class="canva-text display-font leading-tight" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 25px; line-height: 1.15;">Add someone new</h2>
       <p data-template-id="form-subtitle" class="canva-text mt-3 leading-6" style="color: rgb(104, 114, 107); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.6;">Create a concise profile with the details your team needs most.</p>
       <form id="profile-form" class="mt-6 space-y-4">
        <div><label data-template-id="name-label" for="name-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Name</label> <input id="name-input" data-template-id="name-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] px-3 py-3 text-sm outline-none transition" type="text" required="" placeholder="e.g. Maya Chen" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
        </div>
        <div><label data-template-id="email-label" for="email-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Email</label> <input id="email-input" data-template-id="email-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] px-3 py-3 text-sm outline-none transition" type="email" required="" placeholder="maya@example.com" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
        </div>
        <div><label data-template-id="role-label" for="role-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Role</label> <input id="role-input" data-template-id="role-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] px-3 py-3 text-sm outline-none transition" type="text" required="" placeholder="e.g. Creative Director" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
        </div>
        <div><label data-template-id="photo-label" for="photo-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Photo URL</label> <input id="photo-input" data-template-id="photo-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] px-3 py-3 text-sm outline-none transition" type="url" placeholder="https://example.com/photo.jpg" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
        </div>
        <p id="form-message" class="hidden text-sm rounded-xl px-3 py-2"></p>
        <div class="flex gap-3 pt-2"><button id="submit-button" data-template-id="submit-button" class="canva-button focus-ring inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold transition flex-1" type="submit" style="background: rgb(23, 63, 49); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 15px;">Save profile</button> <button id="cancel-button" data-template-id="cancel-button" class="canva-button focus-ring inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold transition hidden" type="button" style="background: rgb(238, 232, 221); color: rgb(79, 93, 84); font-weight: 700; font-style: normal; font-size: 15px;">Cancel</button>
        </div>
       </form>
      </aside>
     </section>
    </div>
   </main>
  </div>
  <template id="profile-card-template">
   <article data-template-id="profile-card" class="canva-card profile-card row-enter rounded-[22px] border border-[#e4ddd1] bg-[#fffdfa] p-4">
    <div class="flex items-start gap-4">
     <div class="w-16 h-16 rounded-2xl overflow-hidden shrink-0 avatar-shell"><img class="profile-photo w-full h-full object-cover hidden" loading="lazy" alt="">
      <div class="avatar-fallback w-full h-full flex items-center justify-center font-semibold text-lg"></div>
     </div>
     <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
       <div class="min-w-0">
        <h3 class="profile-name font-semibold text-[#20342b] truncate"></h3>
        <p class="profile-role text-sm text-[#647069] mt-1 truncate"></p>
       </div><button class="edit-button focus-ring w-8 h-8 rounded-full border border-[#d8d2c7] flex items-center justify-center text-[#557062] hover:bg-[#eef4ed]" type="button" aria-label="Edit profile"> <i data-lucide="pencil" class="w-4 h-4"></i> </button>
      </div>
      <div class="mt-4 space-y-2">
       <p class="profile-email text-sm text-[#59625c] truncate"></p>
       <p class="profile-date text-xs uppercase tracking-[0.14em] text-[#8a928c]"></p>
      </div>
      <div class="mt-4 flex items-center justify-between gap-3"><span class="inline-flex rounded-full bg-[#eef4ed] px-3 py-1 text-xs font-semibold text-[#315c49] profile-role-pill"></span>
       <div class="delete-actions"><button class="delete-button focus-ring inline-flex items-center gap-1 text-xs font-semibold text-[#9a5b51]" type="button"> <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> <span>Delete</span> </button>
        <div class="confirm-delete hidden items-center gap-2"><button class="confirm-delete-button focus-ring rounded-lg bg-[#9a5b51] px-2.5 py-1.5 text-xs font-semibold text-white" type="button">Confirm</button> <button class="cancel-delete-button focus-ring rounded-lg bg-[#eee8dd] px-2.5 py-1.5 text-xs font-semibold text-[#5f665f]" type="button">Cancel</button>
        </div>
       </div>
      </div>
     </div>
    </div>
   </article>
  </template>
  <script>
    let profiles = [];
    let editingRecord = null;
    let searchTerm = '';

    const profileGrid = document.getElementById('profile-grid');
    const emptyState = document.getElementById('empty-state');
    const form = document.getElementById('profile-form');
    const nameInput = document.getElementById('name-input');
    const emailInput = document.getElementById('email-input');
    const roleInput = document.getElementById('role-input');
    const photoInput = document.getElementById('photo-input');
    const submitButton = document.getElementById('submit-button');
    const cancelButton = document.getElementById('cancel-button');
    const formMessage = document.getElementById('form-message');

    function getInitials(name){
      return (name || '?')
        .split(' ')
        .filter(Boolean)
        .slice(0,2)
        .map(part => part[0].toUpperCase())
        .join('') || '?';
    }

    function formatDate(iso){
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return 'Added recently';
      return 'Added ' + new Intl.DateTimeFormat('en-US', { month:'short', day:'numeric' }).format(date);
    }

    function filteredProfiles(){
      const q = searchTerm.trim().toLowerCase();
      return [...profiles]
        .filter(profile => {
          if(!q) return true;
          return [profile.name, profile.email, profile.role].some(value => String(value || '').toLowerCase().includes(q));
        })
        .sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
    }

    function createProfileCard(profile){
      const frag = document.getElementById('profile-card-template').content.cloneNode(true);
      const card = frag.querySelector('article');
      card.dataset.id = profile.__backendId;
      updateProfileCard(card, profile);
      return card;
    }

    function updateProfileCard(card, profile){
      card.querySelector('.profile-name').textContent = profile.name || 'Unnamed profile';
      card.querySelector('.profile-role').textContent = profile.role || 'Team member';
      card.querySelector('.profile-email').textContent = profile.email || 'No email provided';
      card.querySelector('.profile-role-pill').textContent = profile.role || 'Team member';
      card.querySelector('.profile-date').textContent = formatDate(profile.created_at);

      const img = card.querySelector('.profile-photo');
      const fallback = card.querySelector('.avatar-fallback');
      if(profile.photo_url){
        img.src = profile.photo_url;
        img.alt = profile.name ? `${profile.name} profile photo` : 'Profile photo';
        img.classList.remove('hidden');
        fallback.classList.add('hidden');
        img.onerror = () => {
          img.classList.add('hidden');
          fallback.classList.remove('hidden');
          fallback.textContent = getInitials(profile.name);
        };
      } else {
        img.classList.add('hidden');
        fallback.classList.remove('hidden');
        fallback.textContent = getInitials(profile.name);
      }

      const editButton = card.querySelector('.edit-button');
      editButton.onclick = () => startEdit(profile);

      const deleteButton = card.querySelector('.delete-button');
      const confirmWrap = card.querySelector('.confirm-delete');
      const confirmDeleteButton = card.querySelector('.confirm-delete-button');
      const cancelDeleteButton = card.querySelector('.cancel-delete-button');

      deleteButton.onclick = () => {
        deleteButton.classList.add('hidden');
        confirmWrap.classList.remove('hidden');
        confirmWrap.classList.add('flex');
      };

      cancelDeleteButton.onclick = () => {
        confirmWrap.classList.add('hidden');
        confirmWrap.classList.remove('flex');
        deleteButton.classList.remove('hidden');
      };

      confirmDeleteButton.onclick = async () => {
        confirmDeleteButton.disabled = true;
        cancelDeleteButton.disabled = true;
        confirmDeleteButton.textContent = 'Deleting...';
        const result = await window.dataSdk.delete(profile);
        if(result.isError){
          showMessage('Could not delete this profile. Please try again.', 'error');
          confirmDeleteButton.textContent = 'Confirm';
          confirmDeleteButton.disabled = false;
          cancelDeleteButton.disabled = false;
        }
      };
    }

    function renderProfiles(){
      const visible = filteredProfiles();
      const existing = new Map([...profileGrid.children].map(el => [el.dataset.id, el]));

      visible.forEach(profile => {
        if(existing.has(profile.__backendId)){
          const card = existing.get(profile.__backendId);
          updateProfileCard(card, profile);
          profileGrid.appendChild(card);
          existing.delete(profile.__backendId);
        } else {
          profileGrid.appendChild(createProfileCard(profile));
        }
      });

      existing.forEach(el => el.remove());

      emptyState.classList.toggle('hidden', visible.length > 0);
      profileGrid.classList.toggle('hidden', visible.length === 0);

      document.getElementById('metric-total').textContent = profiles.length;
      document.getElementById('metric-roles').textContent = new Set(profiles.map(p => p.role).filter(Boolean)).size;
      document.getElementById('metric-visible').textContent = visible.length;

      const newest = [...profiles].sort((a,b) => new Date(b.created_at) - new Date(a.created_at))[0];
      document.getElementById('metric-newest').textContent = newest ? newest.name.split(' ')[0] : '—';

      lucide.createIcons();
    }

    function showMessage(text, type){
      formMessage.textContent = text;
      formMessage.className = 'text-sm rounded-xl px-3 py-2';
      if(type === 'error'){
        formMessage.classList.add('bg-[#f3e4e0]', 'text-[#8b5148]');
      } else {
        formMessage.classList.add('bg-[#e6eee6]', 'text-[#2f684f]');
      }
    }

    function clearMessage(){
      formMessage.className = 'hidden text-sm rounded-xl px-3 py-2';
      formMessage.textContent = '';
    }

    function resetForm(){
      editingRecord = null;
      form.reset();
      cancelButton.classList.add('hidden');
      clearMessage();
    }

    function startEdit(profile){
      editingRecord = profile;
      nameInput.value = profile.name || '';
      emailInput.value = profile.email || '';
      roleInput.value = profile.role || '';
      photoInput.value = profile.photo_url || '';
      cancelButton.classList.remove('hidden');
      clearMessage();
      nameInput.focus();
      document.querySelector('[data-template-id="form-title"]').scrollIntoView({behavior:'smooth', block:'center'});
    }

    function setFormLoading(isLoading){
      [nameInput, emailInput, roleInput, photoInput, submitButton, cancelButton].forEach(el => el.disabled = isLoading);
      submitButton.classList.toggle('opacity-70', isLoading);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearMessage();

      if(profiles.length >= 999 && !editingRecord){
        showMessage('This directory has reached the maximum of 999 profiles. Delete one before adding another.', 'error');
        return;
      }

      const payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        role: roleInput.value.trim(),
        photo_url: photoInput.value.trim(),
        created_at: editingRecord ? editingRecord.created_at : new Date().toISOString()
      };

      if(!payload.name || !payload.email || !payload.role){
        showMessage('Please complete name, email, and role.', 'error');
        return;
      }

      setFormLoading(true);
      const result = editingRecord
        ? await window.dataSdk.update({...editingRecord, ...payload})
        : await window.dataSdk.create(payload);

      setFormLoading(false);

      if(result.isError){
        showMessage(editingRecord ? 'Could not update this profile. Please try again.' : 'Could not add this profile. Please try again.', 'error');
        return;
      }

      showMessage(editingRecord ? 'Profile updated successfully.' : 'Profile added successfully.', 'success');
      resetForm();
    });

