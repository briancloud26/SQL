           </div>
          </div>
          <div id="planJoin" class="plan-node">
           <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
             <span class="w-8 h-8 rounded-xl bg-[#dce9ff] text-[#2d4c78] flex items-center justify-center"><i data-lucide="git-merge" class="w-4 h-4"></i></span>
             <div>
              <div data-template-id="plan-join-title" class="canva-text text-sm font-semibold text-white"></div>
              <div data-template-id="plan-join-copy" class="canva-text text-xs text-white/55 mt-0.5"></div>
             </div>
            </div><span class="text-[10px] text-[#c9f2d8]">cost 12.4–28.2</span>
           </div>
          </div>
          <div id="planAggregate" class="plan-node">
           <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
             <span class="w-8 h-8 rounded-xl bg-[#f7edcf] text-[#7a5b14] flex items-center justify-center"><i data-lucide="sigma" class="w-4 h-4"></i></span>
             <div>
              <div data-template-id="plan-aggregate-title" class="canva-text text-sm font-semibold text-white"></div>
              <div data-template-id="plan-aggregate-copy" class="canva-text text-xs text-white/55 mt-0.5"></div>
             </div>
            </div><span class="text-[10px] text-[#c9f2d8]">cost 28.2–41.1</span>
           </div>
          </div>
          <div id="planSort" class="plan-node">
           <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
             <span class="w-8 h-8 rounded-xl bg-[#e6eadf] text-[#53664a] flex items-center justify-center"><i data-lucide="arrow-down-up" class="w-4 h-4"></i></span>
             <div>
              <div data-template-id="plan-sort-title" class="canva-text text-sm font-semibold text-white"></div>
              <div data-template-id="plan-sort-copy" class="canva-text text-xs text-white/55 mt-0.5"></div>
             </div>
            </div><span class="text-[10px] text-[#c9f2d8]">cost 41.1–43.0</span>
           </div>
          </div>
         </div>
        </div>
        <div class="px-5 py-4 border-t border-white/10">
         <p data-template-id="plan-footnote" class="canva-text text-xs text-white/55"></p>
        </div>
       </div>
      </aside>
     </section>
    </main>
   </div>
  </div>
  <script src="/_sdk/editing_sdk.js"></script>
  <script>
    lucide.createIcons();

    const sqlPreview = document.getElementById('sqlPreview');
    const queryPreview = document.getElementById('queryPreview');
    const copySqlBtn = document.getElementById('copySqlBtn');
    const copyQueryBtn = document.getElementById('copyQueryBtn');
    const exportBtn = document.getElementById('exportBtn');
    const addTableBtn = document.getElementById('addTableBtn');

    const schemaTab = document.getElementById('schemaTab');
    const queryTab = document.getElementById('queryTab');
    const planTab = document.getElementById('planTab');
    const schemaPane = document.getElementById('schemaPane');
    const queryPane = document.getElementById('queryPane');
    const planPane = document.getElementById('planPane');

    const queryType = document.getElementById('queryType');
    const queryTable = document.getElementById('queryTable');
    const baseAlias = document.getElementById('baseAlias');
    const joinType = document.getElementById('joinType');
    const joinTable = document.getElementById('joinTable');
    const joinAlias = document.getElementById('joinAlias');
    const columnChecks = document.getElementById('columnChecks');
    const aggregateFn = document.getElementById('aggregateFn');
    const aggregateColumn = document.getElementById('aggregateColumn');
    const filterColumn = document.getElementById('filterColumn');
    const filterValue = document.getElementById('filterValue');
    const groupColumn = document.getElementById('groupColumn');
    const havingValue = document.getElementById('havingValue');
    const subqueryToggle = document.getElementById('subqueryToggle');
    const sortColumn = document.getElementById('sortColumn');
    const sortDirection = document.getElementById('sortDirection');
    const limitInput = document.getElementById('limitInput');
    const canvas = document.getElementById('canvas');

    const columnsWrap = document.getElementById('columnsWrap');
    const joinWrap = document.getElementById('joinWrap');
    const aggregateWrap = document.getElementById('aggregateWrap');
    const groupWrap = document.getElementById('groupWrap');
    const havingWrap = document.getElementById('havingWrap');
    const sortWrap = document.getElementById('sortWrap');
    const limitWrap = document.getElementById('limitWrap');

    const planJoin = document.getElementById('planJoin');
    const planAggregate = document.getElementById('planAggregate');

    let customCount = 4;
    const dynamicTables = [];

    const schema = {
      users: [['id','UUID PRIMARY KEY'],['full_name','TEXT NOT NULL'],['email','TEXT UNIQUE NOT NULL'],['created_at','TIMESTAMP DEFAULT NOW()']],
      orders: [['id','UUID PRIMARY KEY'],['user_id','UUID REFERENCES users(id)'],['total_amount','INTEGER NOT NULL'],['created_at','TIMESTAMP DEFAULT NOW()']],
      products: [['id','UUID PRIMARY KEY'],['name','TEXT NOT NULL'],['price_cents','INTEGER NOT NULL']],
      payments: [['id','UUID PRIMARY KEY'],['order_id','UUID REFERENCES orders(id)'],['status','TEXT NOT NULL']]
    };

    function makeSql(){
      const base = Object.entries(schema).map(([table, columns]) => {
        return `CREATE TABLE ${table} (\\n${columns.map(([n,t]) => `  ${n} ${t}`).join(',\\n')}\\n);`;
      }).join('\\n\\n');
      return base + '\\n\\nCREATE INDEX idx_orders_user_id ON orders(user_id);\\nCREATE INDEX idx_payments_order_id ON payments(order_id);\\nALTER TABLE orders ADD CONSTRAINT orders_total_positive CHECK (total_amount > 0);';
    }

    function renderSql(){ sqlPreview.textContent = makeSql(); }

    function setActiveTab(tab){
      schemaPane.classList.toggle('hidden', tab !== 'schema');
      queryPane.classList.toggle('hidden', tab !== 'query');
      planPane.classList.toggle('hidden', tab !== 'plan');
      schemaTab.className = 'focus-ring rounded-xl px-3 py-2 text-xs font-semibold ' + (tab === 'schema' ? 'tab-active' : 'tab-inactive');
      queryTab.className = 'focus-ring rounded-xl px-3 py-2 text-xs font-semibold ' + (tab === 'query' ? 'tab-active' : 'tab-inactive');
      planTab.className = 'focus-ring rounded-xl px-3 py-2 text-xs font-semibold ' + (tab === 'plan' ? 'tab-active' : 'tab-inactive');
    }

    function getCols(table){ return schema[table].map(([name]) => name); }

    function renderColumns(){
      const cols = getCols(queryTable.value);
      columnChecks.innerHTML = '';
      [aggregateColumn, filterColumn, groupColumn, sortColumn].forEach(el => el.innerHTML = '');
      cols.forEach((col, i) => {
        const label = document.createElement('label');
        label.className = 'flex items-center gap-2 rounded-lg border border-[#dce7df] px-2.5 py-2 text-xs text-[#315442] bg-white';
        label.innerHTML = `<input type="checkbox" value="${col}" ${i < 3 ? 'checked' : ''} class="accent-[#275642]"> <span>${col}</span>`;
        columnChecks.appendChild(label);
        [aggregateColumn, filterColumn, groupColumn, sortColumn].forEach(el => {
          const opt = document.createElement('option');
          opt.value = col; opt.textContent = col; el.appendChild(opt);
        });
      });
      renderQuery();
    }

    function selectedColumns(){
      return [...columnChecks.querySelectorAll('input:checked')].map(i => i.value);
    }

    function joinCondition(base, joined, baseA, joinA){
      if(base === 'orders' && joined === 'users') return `${baseA}.user_id = ${joinA}.id`;
      if(base === 'payments' && joined === 'orders') return `${baseA}.order_id = ${joinA}.id`;
      if(base === 'orders' && joined === 'payments') return `${baseA}.id = ${joinA}.order_id`;
      if(base === 'users' && joined === 'orders') return `${baseA}.id = ${joinA}.user_id`;
      return `${baseA}.id = ${joinA}.id`;
    }

    function renderQuery(){
      const type = queryType.value;
      const table = queryTable.value;
      const alias = (baseAlias.value || table[0]).trim();
      const cols = selectedColumns();
      const filterCol = filterColumn.value || getCols(table)[0];
      const filterVal = filterValue.value.trim();
      const join = joinType.value;
      const joined = joinTable.value;
      const jAlias = (joinAlias.value || joined[0]).trim();
      const agg = aggregateFn.value;
      const aggCol = aggregateColumn.value;
      const group = groupColumn.value;
      const having = havingValue.value.trim();
      const hasSubquery = subqueryToggle.checked;

      const selectMode = type === 'select';
      joinWrap.classList.toggle('hidden', !selectMode);
      aggregateWrap.classList.toggle('hidden', !selectMode);
      groupWrap.classList.toggle('hidden', !selectMode || !agg);
      havingWrap.classList.toggle('hidden', !selectMode || !agg);
      sortWrap.classList.toggle('hidden', !selectMode);
      limitWrap.classList.toggle('hidden', !selectMode);
      columnsWrap.classList.toggle('hidden', type === 'delete');

      let query = '';

      if(type === 'select'){
        let selected = cols.length ? cols.map(c => `${alias}.${c}`) : [`${alias}.*`];
        if(agg) selected.push(`${agg}(${alias}.${aggCol}) AS ${agg.toLowerCase()}_${aggCol}`);
        query = `SELECT ${selected.join(', ')}\\nFROM ${table} ${alias}`;
        if(join){
          query += `\\n${join} ${joined} ${jAlias}\\n  ON ${joinCondition(table, joined, alias, jAlias)}`;
        }
        if(filterVal){
          query += `\\nWHERE ${alias}.${filterCol} = '${filterVal.replace(/'/g, "''")}'`;
        }
        if(hasSubquery){
          query += `${filterVal ? '\\n  AND' : '\\nWHERE'} ${alias}.id IN (\\n  SELECT order_id\\n  FROM payments\\n  WHERE status = 'paid'\\n)`;
        }
        if(agg && group) query += `\\nGROUP BY ${alias}.${group}`;
        if(agg && having) query += `\\nHAVING ${agg}(${alias}.${aggCol}) > ${having}`;
        if(sortColumn.value) query += `\\nORDER BY ${alias}.${sortColumn.value} ${sortDirection.value}`;
        if(limitInput.value) query += `\\nLIMIT ${limitInput.value}`;
        query += ';';
      } else if(type === 'insert'){
        const useCols = cols.length ? cols : getCols(table).slice(0,2);
        query = `INSERT INTO ${table} (${useCols.join(', ')})\\nVALUES (${useCols.map(() => "'value'").join(', ')});`;
      } else if(type === 'update'){
        const useCols = cols.length ? cols : getCols(table).slice(1,2);
        query = `UPDATE ${table}\\nSET ${useCols.map(c => `${c} = 'value'`).join(', ')}\\nWHERE ${getCols(table)[0]} = 'id';`;
      } else {
        query = `DELETE FROM ${table}\\nWHERE ${getCols(table)[0]} = 'id';`;
      }

      queryPreview.textContent = query;
      planJoin.style.opacity = join && selectMode ? '1' : '.42';
      planAggregate.style.opacity = agg && selectMode ? '1' : '.42';
    }

    function copyText(button, text){
      const original = button.innerHTML;
      navigator.clipboard.writeText(text).then(() => {
        button.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Copied</span>';
        lucide.createIcons();
        setTimeout(() => { button.innerHTML = original; lucide.createIcons(); }, 1400);
      }).catch(() => {
        button.innerHTML = '<i data-lucide="x" class="w-4 h-4"></i><span>Failed</span>';
        lucide.createIcons();
        setTimeout(() => { button.innerHTML = original; lucide.createIcons(); }, 1400);
      });
    }

    function createDynamicTable(name){
      const index = dynamicTables.length;
      const x = 360 + (index % 2) * 235;
      const y = 470 + Math.floor(index / 2) * 160;
      dynamicTables.push(name);
      const article = document.createElement('article');
      article.className = 'table-card absolute bg-white rounded-2xl overflow-hidden z-10';
      article.style.left = x + 'px';
      article.style.top = y + 'px';
      article.style.width = '210px';
      article.innerHTML = `
        <div class="px-4 py-3 bg-[#3e705f] text-white flex items-center justify-between">
          <div class="flex items-center gap-2"><span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center"><i data-lucide="table-2" class="w-4 h-4"></i></span><h3 class="font-semibold text-sm">${name}</h3></div>
          <button class="delete-table text-white/80 hover:text-white focus-ring" aria-label="Delete ${name}"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="divide-y divide-[#edf1ed]">
          <div class="px-4 py-3 flex items-center justify-between"><div><div class="text-sm font-semibold text-[#24483a]">id</div><div class="text-[11px] text-[#879189] mt-0.5">UUID</div></div><span class="px-2 py-1 rounded-md bg-[#fff3d8] text-[#9a6d17] text-[10px] font-semibold">PK</span></div>
          <div class="px-4 py-3"><div class="text-sm font-semibold text-[#24483a]">name</div><div class="text-[11px] text-[#879189] mt-0.5">TEXT</div></div>
          <div class="px-4 py-3"><div class="text-sm font-semibold text-[#24483a]">created_at</div><div class="text-[11px] text-[#879189] mt-0.5">TIMESTAMP</div></div>
        </div>`;
      article.querySelector('.delete-table').addEventListener('click', () => article.remove());
      canvas.appendChild(article);
      lucide.createIcons();
    }

    schemaTab.addEventListener('click', () => setActiveTab('schema'));
    queryTab.addEventListener('click', () => setActiveTab('query'));
    planTab.addEventListener('click', () => setActiveTab('plan'));

    [queryType, queryTable, baseAlias, joinType, joinTable, joinAlias, aggregateFn, aggregateColumn, filterColumn, filterValue, groupColumn, havingValue, subqueryToggle, sortColumn, sortDirection, limitInput].forEach(el => {
      el.addEventListener(el.tagName === 'INPUT' && el.type !== 'checkbox' ? 'input' : 'change', el === queryTable ? renderColumns : renderQuery);
    });
    columnChecks.addEventListener('change', renderQuery);

    copySqlBtn.addEventListener('click', () => copyText(copySqlBtn, sqlPreview.textContent));
    copyQueryBtn.addEventListener('click', () => copyText(copyQueryBtn, queryPreview.textContent));

    exportBtn.addEventListener('click', () => {
      const content = makeSql() + '\\n\\n-- Current query\\n' + queryPreview.textContent;
      const blob = new Blob([content], {type:'text/sql'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'schema-and-query.sql';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    addTableBtn.addEventListener('click', () => {
      customCount += 1;
      createDynamicTable(`table_${customCount}`);
    });

    document.querySelectorAll('.entity-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        customCount += 1;
        createDynamicTable(`${btn.dataset.entity}_${customCount}`);
      });
    });

    document.querySelectorAll('.template-query').forEach(btn => {
      btn.addEventListener('click', () => {
        setActiveTab('query');
        queryType.value = 'select';
        if(btn.dataset.query === 'aggregate'){
          aggregateFn.value = 'SUM';
          groupColumn.value = 'user_id';
          joinType.value = 'INNER JOIN';
          joinTable.value = 'users';
          subqueryToggle.checked = false;
        } else if(btn.dataset.query === 'subquery'){
          aggregateFn.value = '';
          joinType.value = '';
          subqueryToggle.checked = true;
        } else {
          aggregateFn.value = '';
          joinType.value = 'INNER JOIN';
          joinTable.value = 'users';
          subqueryToggle.checked = false;
        }
        renderQuery();
      });
    });

    renderSql();
