          <div><label data-template-id="query-table-label" for="queryTable" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></label> <select id="queryTable" class="query-control"> <option value="orders">orders</option> <option value="users">users</option> <option value="products">products</option> <option value="payments">payments</option> </select>
          </div>
          <div id="joinWrap">
           <div data-template-id="query-join-label" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></div>
