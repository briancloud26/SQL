      --amber:#d9b86c;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:'DM Sans',sans-serif;color:var(--ink)}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 25% 10%, rgba(214,238,221,.72), transparent 28%),
        linear-gradient(180deg,#f5f8f3 0%,#eef4ec 100%);
    }
    .canvas-grid{
      background-image:
        linear-gradient(rgba(45,76,63,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(45,76,63,.07) 1px, transparent 1px);
      background-size:28px 28px;
      background-color:#f8fbf6;
    }
    .table-card{box-shadow:0 18px 40px rgba(31,57,45,.10);border:1px solid rgba(30,63,48,.11)}
    .mono{font-family:'Space Mono',monospace}
    .scroll-soft::-webkit-scrollbar{height:8px;width:8px}
    .scroll-soft::-webkit-scrollbar-track{background:transparent}
    .scroll-soft::-webkit-scrollbar-thumb{background:#cbd7ce;border-radius:999px}
    .focus-ring:focus-visible{outline:3px solid rgba(80,160,117,.35);outline-offset:2px}
    .connector{position:absolute;height:2px;background:#5f8f78;transform-origin:left center;z-index:0}
    .connector::after{content:'';position:absolute;right:-5px;top:-4px;width:10px;height:10px;border-radius:999px;background:#5f8f78}
    .tab-active{background:#f2faf4;color:#173b2f}
    .tab-inactive{color:rgba(255,255,255,.58)}
    .query-control{
      width:100%;
      border:1px solid #d9e5dc;
      background:#fbfdfb;
      border-radius:12px;
      padding:.7rem .8rem;
      font-size:.83rem;
      color:#24483a;
    }
    .query-control:focus{outline:3px solid rgba(80,160,117,.18);border-color:#9ab8a6}
    .plan-node{
      border:1px solid rgba(255,255,255,.14);
      background:rgba(255,255,255,.07);
      border-radius:16px;
      padding:14px;
      position:relative;
    }
    .plan-node:not(:last-child)::after{
      content:'';
      position:absolute;
      left:24px;
      bottom:-18px;
      width:2px;
      height:18px;
      background:rgba(201,242,216,.34);
    }
    @media (max-width:1180px){
      .workspace-grid{grid-template-columns:220px minmax(540px,1fr) 360px !important}
    }
    @media (max-width:980px){
      .workspace-grid{grid-template-columns:1fr !important}
      .left-panel,.right-panel{display:none}
      .main-stage{min-height:760px}
    }
    @media (max-width:700px){
      .sidebar{display:none}
      .header-actions{width:100%;justify-content:flex-start;margin-top:14px}
      .top-header{align-items:flex-start;flex-direction:column}
    }
  </style>
