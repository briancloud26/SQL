          <h2 data-template-id="sql-panel-title" class="canva-text font-semibold text-white"></h2>
          <p data-template-id="sql-panel-subtitle" class="canva-text text-sm text-white/58 mt-1"></p>
         </div><button data-template-id="copy-sql-button" id="copySqlBtn" class="canva-button focus-ring inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white/10 hover:bg-white/15 text-sm font-medium text-white"><i data-lucide="copy" class="w-4 h-4"></i></button>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4"><button id="schemaTab" class="focus-ring rounded-xl px-3 py-2 text-xs font-semibold tab-active">Schema</button> <button id="queryTab" class="focus-ring rounded-xl px-3 py-2 text-xs font-semibold tab-inactive">Builder</button> <button id="planTab" class="focus-ring rounded-xl px-3 py-2 text-xs font-semibold tab-inactive">Plan</button>
