           <div class="grid grid-cols-[1fr_86px] gap-2"><select id="filterColumn" class="query-control"></select> <input id="filterValue" class="query-control" type="text" placeholder="value">
           </div>
          </div>
          <div id="groupWrap">
           <div data-template-id="query-group-label" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></div><select id="groupColumn" class="query-control"></select>
          </div>
          <div id="havingWrap"><label data-template-id="query-having-label" for="havingValue" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></label> <input id="havingValue" class="query-control" type="number" value="1000">
          </div><label class="flex items-center gap-2 text-xs text-[#436250]"> <input id="subqueryToggle" type="checkbox" class="accent-[#275642]"> <span data-template-id="query-subquery-label" class="canva-text"></span> </label>
          <div id="sortWrap">
           <div data-template-id="query-sort-label" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></div>
           <div class="grid grid-cols-[1fr_88px] gap-2"><select id="sortColumn" class="query-control"></select> <select id="sortDirection" class="query-control"> <option>ASC</option> <option>DESC</option> </select>
           </div>
          </div>
          <div id="limitWrap"><label data-template-id="query-limit-label" for="limitInput" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></label> <input id="limitInput" class="query-control" type="number" min="1" value="20">
          </div>
          <div class="rounded-2xl bg-[#173b2f] p-4">
           <div class="flex items-center justify-between gap-3 mb-3"><span class="text-xs uppercase tracking-[0.18em] text-white/55 font-semibold">Generated query</span> <button data-template-id="copy-query-button" id="copyQueryBtn" class="canva-button focus-ring inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-medium text-white"><i data-lucide="copy" class="w-3.5 h-3.5"></i></button>
           </div>
           <pre id="queryPreview" class="mono text-[11px] leading-5 whitespace-pre-wrap text-[#dceee4]"></pre>
          </div>
         </div>
        </div>
        <div class="px-5 py-4 border-t border-white/10">
         <p data-template-id="query-footnote" class="canva-text text-xs text-white/55"></p>
        </div>
       </div>
       <div id="planPane" class="hidden">
        <div class="px-5 py-5 h-[560px] overflow-auto scroll-soft">
         <div class="mb-4">
          <h3 data-template-id="plan-title" class="canva-text font-semibold text-white"></h3>
          <p data-template-id="plan-subtitle" class="canva-text text-sm text-white/58 mt-1"></p>
         </div>
         <div class="space-y-4">
          <div id="planScan" class="plan-node">
           <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
             <span class="w-8 h-8 rounded-xl bg-[#d8f5df] text-[#173b2f] flex items-center justify-center"><i data-lucide="table-2" class="w-4 h-4"></i></span>
             <div>
              <div data-template-id="plan-scan-title" class="canva-text text-sm font-semibold text-white"></div>
              <div data-template-id="plan-scan-copy" class="canva-text text-xs text-white/55 mt-0.5"></div>
             </div>
