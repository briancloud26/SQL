           </div>
           <div><label data-template-id="query-alias-label" for="baseAlias" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></label> <input id="baseAlias" class="query-control" value="o" maxlength="3">
