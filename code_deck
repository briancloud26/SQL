<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Trace Dashboard</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#173f31;
      --ink-soft:#355849;
      --muted:#728076;
      --paper:#f6f2ea;
      --paper-2:#fbfaf6;
      --line:#dcd4c7;
      --sage:#e5eee2;
      --sage-2:#d4e1d0;
      --deep:#173f31;
      --cream:#fffdf8;
      --gold:#b7a177;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:'DM Sans',sans-serif;
      color:var(--ink);
      min-width:320px;
    }
    .display-font{font-family:'Fraunces',serif}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 88% 8%, rgba(219,229,217,.75), transparent 22%),
        radial-gradient(circle at 8% 20%, rgba(255,255,255,.9), transparent 20%),
        linear-gradient(135deg,#f8f5ef 0%,#eee7dc 100%);
    }
    .noise{
      background-image:radial-gradient(rgba(24,60,48,.03) 1px,transparent 1px);
      background-size:18px 18px;
    }
    .focus-ring:focus-visible{outline:3px solid rgba(39,93,73,.22);outline-offset:3px}
    .soft-shadow{box-shadow:0 18px 50px rgba(29,55,43,.08)}
    .metric-card{transition:transform .25s ease, box-shadow .25s ease}
    .metric-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(29,55,43,.08)}
    .field{
      width:100%;
      border:1px solid #d8d1c6;
      background:#fffdf9;
      color:#173f31;
      border-radius:14px;
      padding:12px 14px;
      outline:none;
      transition:border .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .field:focus{
      border-color:#6d8d7c;
      box-shadow:0 0 0 4px rgba(82,116,98,.12);
      background:#ffffff;
    }
    .chart-grid line{stroke:#e4ddd2;stroke-width:1}
    .chart-axis{stroke:#c9c0b2;stroke-width:1}
    .chart-line{fill:none;stroke:#1f5b45;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}
    .chart-point{fill:#f9f7f0;stroke:#1f5b45;stroke-width:2.5}
    .chart-label{fill:#768076;font-size:11px}
    .fade-in{animation:fadeIn .55s ease both}
    @keyframes fadeIn{
      from{opacity:0;transform:translateY(8px)}
      to{opacity:1;transform:translateY(0)}
    }
    .spinner{
      width:16px;height:16px;border:2px solid rgba(255,255,255,.35);
      border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    @media (max-width: 768px){
      .table-scroll{overflow-x:auto}
    }
  </style>
 <script src="/_sdk/telemetry_sdk.js"></script></head>
 <body data-template-id="__page-root" style="background: linear-gradient(135deg, rgb(248, 245, 239), rgb(238, 231, 220));">
  <div class="app-shell noise w-full">
   <header class="w-full px-5 sm:px-8 lg:px-10 py-6">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-5">
     <div>
      <p data-template-id="header-eyebrow" class="canva-text uppercase tracking-[0.18em] text-[10px] font-semibold mb-1" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.16rem;">Measured with intention</p>
      <h1 data-template-id="brand-name" class="canva-text display-font leading-none" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 28px;">Data Trace</h1>
     </div><button id="jump-to-form" data-template-id="header-add-button" class="canva-button focus-ring inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold" style="background: rgb(23, 63, 49); color: rgb(255, 255, 255); font-weight: 600; font-style: normal; font-size: 15px;">Add entry</button>
    </div>
   </header>
   <main class="w-full px-5 sm:px-8 lg:px-10 pb-10">
    <div class="max-w-7xl mx-auto">
     <section class="pt-8 lg:pt-10 pb-8">
      <div class="grid lg:grid-cols-[1.05fr_.95fr] gap-8 items-end">
       <div>
        <p data-template-id="hero-kicker" class="canva-text uppercase tracking-[0.18em] text-xs font-semibold mb-4" style="color: rgb(111, 123, 114); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.16rem;">Quiet signals / clear patterns</p>
        <h2 data-template-id="hero-title" class="canva-text display-font leading-[1.04] max-w-3xl" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 54px; line-height: 1.04;">Track the details. See the direction.</h2>
       </div>
       <p data-template-id="hero-copy" class="canva-text max-w-xl leading-7 lg:pb-2" style="color: rgb(101, 113, 104); font-weight: 400; font-style: normal; font-size: 16px; line-height: 1.7;">Log recurring values, observe movement over time, and keep your most important signals in one calm, readable workspace.</p>
      </div>
     </section>
     <section class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
      <article data-template-id="stat-card-1" class="canva-card metric-card rounded-[22px] p-5 soft-shadow" style="background: rgb(255, 253, 248);">
       <div class="flex items-center justify-between mb-5">
        <p data-template-id="stat-label-1" class="canva-text uppercase tracking-[0.14em] text-[10px] font-semibold" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Total entries</p><span class="w-9 h-9 rounded-full bg-[#edf3eb] flex items-center justify-center text-[#355849]"><i data-lucide="database" class="w-4 h-4"></i></span>
       </div>
       <p id="total-records" class="display-font text-[34px] leading-none">0</p>
      </article>
      <article data-template-id="stat-card-2" class="canva-card metric-card rounded-[22px] p-5 soft-shadow" style="background: rgb(255, 253, 248);">
       <div class="flex items-center justify-between mb-5">
        <p data-template-id="stat-label-2" class="canva-text uppercase tracking-[0.14em] text-[10px] font-semibold" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Average value</p><span class="w-9 h-9 rounded-full bg-[#edf3eb] flex items-center justify-center text-[#355849]"><i data-lucide="activity" class="w-4 h-4"></i></span>
       </div>
       <p id="average-value" class="display-font text-[34px] leading-none">0</p>
      </article>
      <article data-template-id="stat-card-3" class="canva-card metric-card rounded-[22px] p-5 soft-shadow" style="background: rgb(255, 253, 248);">
       <div class="flex items-center justify-between mb-5">
        <p data-template-id="stat-label-3" class="canva-text uppercase tracking-[0.14em] text-[10px] font-semibold" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Latest value</p><span class="w-9 h-9 rounded-full bg-[#edf3eb] flex items-center justify-center text-[#355849]"><i data-lucide="trending-up" class="w-4 h-4"></i></span>
       </div>
       <p id="latest-value" class="display-font text-[34px] leading-none">0</p>
      </article>
      <article data-template-id="stat-card-4" class="canva-card metric-card rounded-[22px] p-5 soft-shadow" style="background: rgb(255, 253, 248);">
       <div class="flex items-center justify-between mb-5">
        <p data-template-id="stat-label-4" class="canva-text uppercase tracking-[0.14em] text-[10px] font-semibold" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Tracked metrics</p><span class="w-9 h-9 rounded-full bg-[#edf3eb] flex items-center justify-center text-[#355849]"><i data-lucide="layers-3" class="w-4 h-4"></i></span>
       </div>
       <p id="metric-count" class="display-font text-[34px] leading-none">0</p>
      </article>
     </section>
     <section data-template-id="chart-panel" class="canva-panel rounded-[28px] p-5 sm:p-6 lg:p-7 soft-shadow mb-6" style="background: rgb(255, 253, 248);">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
       <div>
        <p data-template-id="chart-kicker" class="canva-text uppercase tracking-[0.16em] text-[10px] font-semibold mb-2" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.16rem;">Trend view</p>
        <h2 data-template-id="chart-title" class="canva-text display-font leading-tight" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 34px; line-height: 1.1;">Movement over time</h2>
        <p data-template-id="chart-copy" class="canva-text mt-2 max-w-2xl leading-6" style="color: rgb(107, 117, 109); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.6;">Follow the latest measurements and filter by metric to reveal a more focused pattern.</p>
       </div>
       <div class="min-w-[190px]"><label data-template-id="filter-label" for="metric-filter" class="canva-text block text-xs font-semibold mb-2" style="color: rgb(78, 98, 86); font-weight: 600; font-style: normal; font-size: 12px;">View metric</label> <select id="metric-filter" class="field text-sm"> <option value="all">All metrics</option> </select>
       </div>
      </div>
      <div class="relative rounded-[20px] bg-[#f7f3ec] border border-[#e1d9ce] p-3 sm:p-4">
       <svg id="trend-chart" viewBox="0 0 760 300" class="w-full h-[280px]" role="img" aria-label="Trend line chart"></svg>
       <div id="chart-empty" class="absolute inset-0 flex items-center justify-center text-center px-6 hidden">
        <div>
         <div class="w-12 h-12 rounded-full bg-[#e9efe6] text-[#466857] flex items-center justify-center mx-auto mb-3"><i data-lucide="line-chart" class="w-5 h-5"></i>
         </div>
         <p data-template-id="chart-empty-title" class="canva-text font-semibold mb-1" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 15px;">No trend to show yet</p>
         <p data-template-id="chart-empty-copy" class="canva-text text-sm" style="color: rgb(122, 133, 125); font-weight: 400; font-style: normal; font-size: 13px;">Add your first entry to begin tracing movement.</p>
        </div>
       </div>
      </div>
     </section>
     <section class="grid lg:grid-cols-[.9fr_1.1fr] gap-6">
      <section id="entry-form-section" data-template-id="form-panel" class="canva-panel rounded-[28px] p-5 sm:p-6 soft-shadow" style="background: rgb(255, 253, 248);">
       <p data-template-id="form-kicker" class="canva-text uppercase tracking-[0.16em] text-[10px] font-semibold mb-2" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.16rem;">New observation</p>
       <h2 data-template-id="form-title" class="canva-text display-font leading-tight" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 30px; line-height: 1.1;">Record a value</h2>
       <p data-template-id="form-copy" class="canva-text mt-2 leading-6" style="color: rgb(107, 117, 109); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.6;">Capture a point in time with just enough context to make the pattern useful later.</p>
       <form id="entry-form" class="mt-6 space-y-4">
        <div><label data-template-id="metric-label" for="metric-name" class="canva-text block text-sm font-semibold mb-2" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 13px;">Metric name</label> <input id="metric-name" type="text" class="field" required="">
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
         <div><label data-template-id="value-label" for="metric-value" class="canva-text block text-sm font-semibold mb-2" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 13px;">Value</label> <input id="metric-value" type="number" step="any" class="field" required="">
         </div>
         <div><label data-template-id="category-label" for="metric-category" class="canva-text block text-sm font-semibold mb-2" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 13px;">Category</label> <input id="metric-category" type="text" class="field">
         </div>
        </div>
        <div><label data-template-id="date-label" for="metric-date" class="canva-text block text-sm font-semibold mb-2" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 13px;">Date &amp; time</label> <input id="metric-date" type="datetime-local" class="field">
        </div>
        <div id="form-message" class="hidden rounded-[14px] px-3 py-2 text-sm"></div><button id="submit-button" data-template-id="submit-button" type="submit" class="canva-button focus-ring inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold w-full sm:w-auto" style="background: rgb(23, 63, 49); color: rgb(255, 255, 255); font-weight: 600; font-style: normal; font-size: 15px;">Save entry</button>
       </form>
      </section>
      <section data-template-id="entries-panel" class="canva-panel rounded-[28px] p-5 sm:p-6 soft-shadow" style="background: rgb(255, 253, 248);">
       <div class="flex items-start justify-between gap-4 mb-5">
        <div>
         <p data-template-id="entries-kicker" class="canva-text uppercase tracking-[0.16em] text-[10px] font-semibold mb-2" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.16rem;">Latest records</p>
         <h2 data-template-id="entries-title" class="canva-text display-font leading-tight" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 30px; line-height: 1.1;">Recent entries</h2>
         <p data-template-id="entries-copy" class="canva-text mt-2 leading-6" style="color: rgb(107, 117, 109); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.6;">A compact view of the latest values added to your trace.</p>
        </div>
        <div class="w-10 h-10 rounded-full bg-[#edf3eb] flex items-center justify-center text-[#355849] shrink-0"><i data-lucide="list-filter" class="w-4 h-4"></i>
        </div>
       </div>
       <div class="table-scroll">
        <table class="w-full border-collapse min-w-[560px]">
         <thead>
          <tr class="border-b border-[#ddd4c8]">
           <th data-template-id="table-head-metric" class="canva-text text-left text-[10px] uppercase tracking-[0.14em] py-3 pr-4" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Metric</th>
           <th data-template-id="table-head-category" class="canva-text text-left text-[10px] uppercase tracking-[0.14em] py-3 pr-4" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Category</th>
           <th data-template-id="table-head-value" class="canva-text text-left text-[10px] uppercase tracking-[0.14em] py-3 pr-4" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Value</th>
           <th data-template-id="table-head-date" class="canva-text text-left text-[10px] uppercase tracking-[0.14em] py-3" style="color: rgb(122, 133, 125); font-weight: 700; font-style: normal; font-size: 10px; letter-spacing: 0.14rem;">Date</th>
          </tr>
         </thead>
         <tbody id="entries-body"></tbody>
        </table>
       </div>
       <div id="entries-empty" class="py-10 text-center hidden">
        <div class="w-12 h-12 rounded-full bg-[#eef3eb] text-[#466857] flex items-center justify-center mx-auto mb-3"><i data-lucide="inbox" class="w-5 h-5"></i>
        </div>
        <p data-template-id="entries-empty-title" class="canva-text font-semibold mb-1" style="color: rgb(53, 88, 73); font-weight: 600; font-style: normal; font-size: 15px;">Nothing logged yet</p>
        <p data-template-id="entries-empty-copy" class="canva-text text-sm" style="color: rgb(122, 133, 125); font-weight: 400; font-style: normal; font-size: 13px;">Your recent entries will appear here.</p>
       </div>
      </section>
     </section>
    </div>
   </main>
   <footer class="w-full px-5 sm:px-8 lg:px-10 py-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
     <p data-template-id="footer-copy" class="canva-text text-sm" style="color: rgb(108, 118, 110); font-weight: 400; font-style: normal; font-size: 13px;">A quieter way to keep an eye on what matters.</p>
     <p data-template-id="footer-note" class="canva-text text-xs" style="color: rgb(138, 148, 140); font-weight: 400; font-style: normal; font-size: 12px;">Saved to your Canva Sheet</p>
    </div>
   </footer>
  </div>
  <script>
    lucide.createIcons();

    const state = {
      records: [],
      selectedMetric: 'all'
    };

    const chartSvg = document.getElementById('trend-chart');
    const chartEmpty = document.getElementById('chart-empty');
    const metricFilter = document.getElementById('metric-filter');
    const entriesBody = document.getElementById('entries-body');
    const entriesEmpty = document.getElementById('entries-empty');
    const form = document.getElementById('entry-form');
    const formMessage = document.getElementById('form-message');
    const submitButton = document.getElementById('submit-button');
    const submitLabel = submitButton.querySelector('.button-label');
    const submitSpinner = submitButton.querySelector('.spinner');
    const submitIcon = submitButton.querySelector('.button-icon');

    function formatNumber(value) {
      if (!Number.isFinite(value)) return '0';
      return Number.isInteger(value) ? String(value) : value.toFixed(1);
    }

    function formatDate(iso) {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return '—';
      return date.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
    }

    function formatShortDate(iso) {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return '';
      return date.toLocaleDateString(undefined, { month:'short', day:'numeric' });
    }

    function setMessage(type, text) {
      formMessage.textContent = text;
      formMessage.className = 'rounded-[14px] px-3 py-2 text-sm';
      if (type === 'success') {
        formMessage.classList.add('bg-[#e9f1e6]', 'text-[#2d6248]');
      } else {
        formMessage.classList.add('bg-[#f6e7df]', 'text-[#9a4c35]');
      }
    }

    function clearMessage() {
      formMessage.textContent = '';
      formMessage.className = 'hidden rounded-[14px] px-3 py-2 text-sm';
    }

    function setSubmitting(isSubmitting) {
      submitButton.disabled = isSubmitting;
      submitButton.classList.toggle('opacity-70', isSubmitting);
      submitSpinner.classList.toggle('hidden', !isSubmitting);
      submitIcon.classList.toggle('hidden', isSubmitting);
      submitLabel.textContent = isSubmitting ? 'Saving...' : 'Save entry';
    }

    function updateStats() {
      const total = state.records.length;
      const values = state.records.map(r => Number(r.value)).filter(Number.isFinite);
      const average = values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
      const sorted = [...state.records].sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
      const latest = sorted[0] ? Number(sorted[0].value) : 0;
      const uniqueMetrics = new Set(state.records.map(r => r.metric_name).filter(Boolean));

      document.getElementById('total-records').textContent = total;
      document.getElementById('average-value').textContent = formatNumber(average);
      document.getElementById('latest-value').textContent = formatNumber(latest);
      document.getElementById('metric-count').textContent = uniqueMetrics.size;
    }

    function updateMetricFilter() {
      const metrics = [...new Set(state.records.map(r => r.metric_name).filter(Boolean))].sort((a,b) => a.localeCompare(b));
      const existing = new Set([...metricFilter.options].map(option => option.value));

      metrics.forEach(metric => {
        if (!existing.has(metric)) {
          const option = document.createElement('option');
          option.value = metric;
          option.textContent = metric;
          metricFilter.appendChild(option);
        }
      });

      [...metricFilter.options].forEach(option => {
        if (option.value !== 'all' && !metrics.includes(option.value)) option.remove();
      });

      if (state.selectedMetric !== 'all' && !metrics.includes(state.selectedMetric)) {
        state.selectedMetric = 'all';
        metricFilter.value = 'all';
      }
    }

    function drawChart() {
      const filtered = state.records
        .filter(record => state.selectedMetric === 'all' || record.metric_name === state.selectedMetric)
        .filter(record => Number.isFinite(Number(record.value)))
        .sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp))
        .slice(-10);

      chartSvg.innerHTML = '';

      if (filtered.length === 0) {
        chartEmpty.classList.remove('hidden');
        lucide.createIcons();
        return;
      }

      chartEmpty.classList.add('hidden');

      const width = 760;
      const height = 300;
      const pad = { top: 24, right: 24, bottom: 42, left: 54 };
      const innerW = width - pad.left - pad.right;
      const innerH = height - pad.top - pad.bottom;
      const values = filtered.map(d => Number(d.value));
      let min = Math.min(...values);
      let max = Math.max(...values);

      if (min === max) {
        min -= 1;
        max += 1;
      } else {
        const range = max - min;
        min -= range * 0.12;
        max += range * 0.12;
      }

      const x = i => pad.left + (filtered.length === 1 ? innerW / 2 : (i / (filtered.length - 1)) * innerW);
      const y = value => pad.top + (1 - ((value - min) / (max - min))) * innerH;

      const grid = document.createElementNS('http://www.w3.org/2000/svg','g');
      grid.setAttribute('class','chart-grid');

      for (let i = 0; i < 4; i++) {
        const gy = pad.top + (innerH / 3) * i;
        const line = document.createElementNS('http://www.w3.org/2000/svg','line');
        line.setAttribute('x1', pad.left);
        line.setAttribute('x2', width - pad.right);
        line.setAttribute('y1', gy);
        line.setAttribute('y2', gy);
        grid.appendChild(line);

        const label = document.createElementNS('http://www.w3.org/2000/svg','text');
        label.setAttribute('x', 10);
        label.setAttribute('y', gy + 4);
        label.setAttribute('class','chart-label');
        const labelValue = max - ((max - min) / 3) * i;
        label.textContent = formatNumber(labelValue);
        chartSvg.appendChild(label);
      }
      chartSvg.appendChild(grid);

      const axisX = document.createElementNS('http://www.w3.org/2000/svg','line');
      axisX.setAttribute('x1', pad.left);
      axisX.setAttribute('x2', width - pad.right);
      axisX.setAttribute('y1', height - pad.bottom);
      axisX.setAttribute('y2', height - pad.bottom);
      axisX.setAttribute('class','chart-axis');
      chartSvg.appendChild(axisX);

      const points = filtered.map((d, i) => [x(i), y(Number(d.value))]);
      const path = document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('class','chart-line');
      path.setAttribute('d', points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point[0]} ${point[1]}`).join(' '));
      chartSvg.appendChild(path);

      points.forEach((point, i) => {
        const circle = document.createElementNS('http://www.w3.org/2000/svg','circle');
        circle.setAttribute('cx', point[0]);
        circle.setAttribute('cy', point[1]);
        circle.setAttribute('r', 5);
        circle.setAttribute('class','chart-point');
        chartSvg.appendChild(circle);

        if (i === 0 || i === points.length - 1 || points.length <= 5 || i % 2 === 0) {
          const xLabel = document.createElementNS('http://www.w3.org/2000/svg','text');
          xLabel.setAttribute('x', point[0]);
          xLabel.setAttribute('y', height - 14);
          xLabel.setAttribute('text-anchor','middle');
          xLabel.setAttribute('class','chart-label');
          xLabel.textContent = formatShortDate(filtered[i].timestamp);
          chartSvg.appendChild(xLabel);
        }
      });
    }

    function renderEntries() {
      const latest = [...state.records]
        .sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp))
        .slice(0, 6);

      const existingRows = new Map([...entriesBody.children].map(row => [row.dataset.id, row]));
      latest.forEach(record => {
        let row = existingRows.get(record.__backendId);
        if (!row) {
          row = document.createElement('tr');
          row.dataset.id = record.__backendId;
          row.className = 'border-b border-[#ebe4da] fade-in';
          row.innerHTML = `
            <td class="py-4 pr-4 text-sm font-medium metric-cell"></td>
            <td class="py-4 pr-4 text-sm text-[#718077] category-cell"></td>
            <td class="py-4 pr-4 text-sm font-semibold value-cell"></td>
            <td class="py-4 text-sm text-[#718077] date-cell"></td>
          `;
          entriesBody.appendChild(row);
        }
        row.querySelector('.metric-cell').textContent = record.metric_name || 'Untitled';
        row.querySelector('.category-cell').textContent = record.category || '—';
        row.querySelector('.value-cell').textContent = formatNumber(Number(record.value));
        row.querySelector('.date-cell').textContent = formatDate(record.timestamp);
        existingRows.delete(record.__backendId);
      });

      existingRows.forEach(row => row.remove());
      entriesEmpty.classList.toggle('hidden', latest.length > 0);
      entriesBody.parentElement.classList.toggle('hidden', latest.length === 0);
      lucide.createIcons();
    }

    function updateUI() {
      updateStats();
      updateMetricFilter();
      drawChart();
      renderEntries();
    }

    metricFilter.addEventListener('change', (event) => {
      state.selectedMetric = event.target.value;
      drawChart();
    });

    document.getElementById('jump-to-form').addEventListener('click', () => {
      document.getElementById('entry-form-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => document.getElementById('metric-name').focus(), 450);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearMessage();

      if (state.records.length >= 999) {
        setMessage('error', 'You’ve reached the 999 entry limit. Remove older rows before adding more.');
        return;
      }

      const metricName = document.getElementById('metric-name').value.trim();
      const rawValue = document.getElementById('metric-value').value;
      const category = document.getElementById('metric-category').value.trim();
      const dateValue = document.getElementById('metric-date').value;
      const numericValue = Number(rawValue);

      if (!metricName) {
        setMessage('error', 'Please enter a metric name.');
        return;
      }
      if (!Number.isFinite(numericValue)) {
        setMessage('error', 'Please enter a valid numeric value.');
        return;
      }

      const timestamp = dateValue ? new Date(dateValue).toISOString() : new Date().toISOString();

      setSubmitting(true);
      const result = await window.dataSdk.create({
        metric_name: metricName,
        value: numericValue,
        timestamp,
        category
      });
      setSubmitting(false);

      if (result.isOk) {
        form.reset();
        setMessage('success', 'Entry saved to your Canva Sheet.');
      } else {
        setMessage('error', 'We couldn’t save that entry. Please try again.');
      }
    });

    async function initData() {
      const handler = {
        onDataChanged(data) {
          state.records = Array.isArray(data) ? data : [];
          updateUI();
        }
      };

      const result = await window.dataSdk.init(handler);
      if (!result.isOk) {
        setMessage('error', 'We couldn’t connect to your Canva Sheet.');
      }
    }

    submitLabel.textContent = 'Save entry';
    initData();
