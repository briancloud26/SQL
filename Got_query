    *{box-sizing:border-box}
    body{margin:0;font-family:'DM Sans',sans-serif;color:var(--ink)}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 25% 10%, rgba(214,238,221,.72), transparent 28%),
        linear-gradient(180deg,#f5f8f3 0%,#eef4ec 100%);
    }
    .canvas-grid{
      background-image:
