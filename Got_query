  <script src="/_sdk/editing_sdk.js"></script>
  <script>
    lucide.createIcons();

    const sqlPreview = document.getElementById('sqlPreview');
    const queryPreview = document.getElementById('queryPreview');
    const ctePreview = document.getElementById('ctePreview');
    const logicPreview = document.getElementById('logicPreview');
    const diffPreview = document.getElementById('diffPreview');

    const panes = {
      schema: document.getElementById('schemaPane'),
      query: document.getElementById('queryPane'),
      cte: document.getElementById('ctePane'),
      logic: document.getElementById('logicPane'),
      diff: document.getElementById('diffPane')
    };
    const tabs = {
      schema: document.getElementById('schemaTab'),
      query: document.getElementById('queryTab'),
      cte: document.getElementById('cteTab'),
      logic: document.getElementById('logicTab'),
      diff: document.getElementById('diffTab')
    };

    const schema = {
      users: [['id','UUID PRIMARY KEY'],['full_name','TEXT NOT NULL'],['email','TEXT UNIQUE NOT NULL'],['created_at','TIMESTAMP DEFAULT NOW()']],
      orders: [['id','UUID PRIMARY KEY'],['user_id','UUID REFERENCES users(id)'],['total_amount','INTEGER NOT NULL'],['created_at','TIMESTAMP DEFAULT NOW()']],
      products: [['id','UUID PRIMARY KEY'],['name','TEXT NOT NULL'],['price_cents','INTEGER NOT NULL']],
      payments: [['id','UUID PRIMARY KEY'],['order_id','UUID REFERENCES orders(id)'],['status','TEXT NOT NULL']]
    };

    function makeSql(){
      return Object.entries(schema).map(([table, columns]) => {
        return `CREATE TABLE ${table} (\\n${columns.map(([n,t]) => `  ${n} ${t}`).join(',\\n')}\\n);`;
      }).join('\\n\\n') +
      '\\n\\nCREATE INDEX idx_orders_user_id ON orders(user_id);\\nCREATE INDEX idx_payments_order_id ON payments(order_id);\\nCREATE VIEW customer_revenue AS\\nSELECT u.id, u.full_name, SUM(o.total_amount) AS lifetime_value\\nFROM users u\\nJOIN orders o ON o.user_id = u.id\\nGROUP BY u.id, u.full_name;';
    }

    function setActiveTab(name){
      Object.keys(panes).forEach(key => panes[key].classList.toggle('hidden', key !== name));
      Object.keys(tabs).forEach(key => tabs[key].className = 'focus-ring rounded-xl px-2 py-2 text-[11px] font-semibold ' + (key === name ? 'tab-active' : 'tab-inactive'));
    }

    function copyText(button, text){
      const original = button.innerHTML;
      navigator.clipboard.writeText(text).then(() => {
        button.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Copied</span>';
        lucide.createIcons();
        setTimeout(() => { button.innerHTML = original; lucide.createIcons(); }, 1300);
      });
    }

    function renderQuery(){
      const table = document.getElementById('queryTable').value;
      const filter = document.getElementById('filterValue').value.trim();
      const subquery = document.getElementById('subqueryToggle').checked;
      let q = `SELECT o.id, o.total_amount, o.created_at\\nFROM ${table} o`;
      if(filter) q += `\\nWHERE o.status = '${filter.replace(/'/g,"''")}'`;
      if(subquery) q += `${filter ? '\\n  AND' : '\\nWHERE'} o.user_id IN (\\n  SELECT id\\n  FROM users\\n  WHERE created_at >= NOW() - INTERVAL '90 days'\\n)`;
      q += '\\nORDER BY o.created_at DESC\\nLIMIT 25;';
      queryPreview.textContent = q;
    }

    function renderCte(){
      const name = document.getElementById('cteName').value || 'recent_orders';
      const source = document.getElementById('cteSource').value;
      const recursive = document.getElementById('recursiveToggle').checked;
      const prefix = recursive ? 'WITH RECURSIVE' : 'WITH';
      ctePreview.textContent =
`${prefix} ${name} AS (
  SELECT *
  FROM ${source}
  WHERE created_at >= NOW() - INTERVAL '30 days'
),
ranked_orders AS (
  SELECT *,
         ROW_NUMBER() OVER (
           PARTITION BY user_id
           ORDER BY created_at DESC
         ) AS order_rank
  FROM ${name}
)
SELECT *
FROM ranked_orders
WHERE order_rank <= 3;`;
    }

    let logicMode = 'view';
    function renderLogic(){
      const name = document.getElementById('logicName').value || 'customer_lifetime_value';
      const source = document.getElementById('logicSource').value;
      if(logicMode === 'view'){
        logicPreview.textContent =
`CREATE OR REPLACE VIEW ${name} AS
SELECT u.id,
       u.full_name,
       SUM(o.total_amount) AS lifetime_value
FROM users u
JOIN ${source} o ON o.user_id = u.id
GROUP BY u.id, u.full_name;`;
      } else if(logicMode === 'function'){
        logicPreview.textContent =
`CREATE OR REPLACE FUNCTION ${name}(customer_id UUID)
RETURNS INTEGER
LANGUAGE plpgsql
AS $$
DECLARE
  total_value INTEGER;
BEGIN
  SELECT COALESCE(SUM(total_amount), 0)
  INTO total_value
  FROM ${source}
  WHERE user_id = customer_id;

  RETURN total_value;
END;
$$;`;
      } else {
        logicPreview.textContent =
`CREATE OR REPLACE FUNCTION sync_${name}()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_${name}
BEFORE UPDATE ON ${source}
FOR EACH ROW
EXECUTE FUNCTION sync_${name}();`;
      }
    }

    function renderDiff(){
      diffPreview.textContent =
`-- migration_004_advanced_objects.sql

ALTER TABLE orders
ADD COLUMN fulfillment_status TEXT DEFAULT 'pending';

CREATE INDEX idx_orders_created_at
ON orders(created_at DESC);

CREATE VIEW customer_revenue AS
SELECT u.id, u.full_name, SUM(o.total_amount) AS lifetime_value
FROM users u
JOIN orders o ON o.user_id = u.id
GROUP BY u.id, u.full_name;

CREATE TRIGGER trg_orders_updated_at
BEFORE UPDATE ON orders
FOR EACH ROW
EXECUTE FUNCTION sync_updated_at();`;
    }

    document.getElementById('schemaTab').addEventListener('click',()=>setActiveTab('schema'));
    document.getElementById('queryTab').addEventListener('click',()=>setActiveTab('query'));
    document.getElementById('cteTab').addEventListener('click',()=>setActiveTab('cte'));
    document.getElementById('logicTab').addEventListener('click',()=>setActiveTab('logic'));
    document.getElementById('diffTab').addEventListener('click',()=>setActiveTab('diff'));

    document.getElementById('queryTable').addEventListener('change', renderQuery);
    document.getElementById('filterValue').addEventListener('input', renderQuery);
    document.getElementById('subqueryToggle').addEventListener('change', renderQuery);
    document.getElementById('cteName').addEventListener('input', renderCte);
    document.getElementById('cteSource').addEventListener('change', renderCte);
    document.getElementById('recursiveToggle').addEventListener('change', renderCte);
    document.getElementById('logicName').addEventListener('input', renderLogic);
    document.getElementById('logicSource').addEventListener('change', renderLogic);

    document.querySelectorAll('.logic-pill').forEach(btn=>{
      btn.addEventListener('click',()=>{
        document.querySelectorAll('.logic-pill').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        logicMode = btn.dataset.logic;
        renderLogic();
      });
    });

    document.querySelectorAll('.advanced-btn').forEach(btn=>{
      btn.addEventListener('click',()=>{
        setActiveTab(btn.dataset.target);
        if(btn.dataset.mode){
          const target = document.querySelector(`.logic-pill[data-logic="${btn.dataset.mode}"]`);
          if(target) target.click();
        }
      });
    });

    document.getElementById('copySqlBtn').addEventListener('click',()=>copyText(document.getElementById('copySqlBtn'),sqlPreview.textContent));
    document.getElementById('copyQueryBtn').addEventListener('click',()=>copyText(document.getElementById('copyQueryBtn'),queryPreview.textContent));
    document.getElementById('copyCteBtn').addEventListener('click',()=>copyText(document.getElementById('copyCteBtn'),ctePreview.textContent));
    document.getElementById('copyLogicBtn').addEventListener('click',()=>copyText(document.getElementById('copyLogicBtn'),logicPreview.textContent));
    document.getElementById('copyDiffBtn').addEventListener('click',()=>copyText(document.getElementById('copyDiffBtn'),diffPreview.textContent));

    document.getElementById('exportBtn').addEventListener('click',()=>{
      const content = [makeSql(), queryPreview.textContent, ctePreview.textContent, logicPreview.textContent, diffPreview.textContent].join('\\n\\n-- -----------------------------\\n\\n');
      const blob = new Blob([content], {type:'text/sql'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'advanced-schema-studio.sql';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    sqlPreview.textContent = makeSql();
    renderQuery();
    renderCte();
    renderLogic();
