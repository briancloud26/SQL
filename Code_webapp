      background-size:28px 28px;
    }
    .hero-glow:before{
      content:"";
      position:absolute;
      inset:auto 8% -8% auto;
      width:34rem;
      height:34rem;
      border-radius:999px;
      background:radial-gradient(circle, rgba(198,231,211,.8), rgba(198,231,211,0));
      filter:blur(10px);
      z-index:0;
    }
    .shadow-soft{box-shadow:0 18px 45px rgba(31,61,54,.11)}
    .shadow-card{box-shadow:0 12px 28px rgba(31,61,54,.08)}
    .nav-link{position:relative}
    .nav-link:after{
      content:"";
      position:absolute;
      left:0;
      right:0;
      bottom:-8px;
      height:1px;
      transform:scaleX(0);
      transform-origin:left;
      transition:transform .25s ease;
      background:var(--ink);
    }
    .nav-link:hover:after{transform:scaleX(1)}
    .price-card{transition:transform .25s ease, box-shadow .25s ease}
    .price-card:hover{transform:translateY(-5px)}
    .fade-up{animation:fadeUp .75s ease both}
    .fade-up.delay-1{animation-delay:.08s}
    .fade-up.delay-2{animation-delay:.16s}
    .fade-up.delay-3{animation-delay:.24s}
    @keyframes fadeUp{
      from{opacity:0; transform:translateY(18px)}
      to{opacity:1; transform:translateY(0)}
    }
    .pricing-switch .switch-dot{transition:transform .25s ease}
    .pricing-switch.is-yearly .switch-dot{transform:translateX(24px)}
    .pricing-switch.is-yearly{background:#21493f}
    @media (max-width: 768px){
      .hero-glow:before{width:22rem;height:22rem;right:-5rem}
    }
