  <script src="/_sdk/editing_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#183c30;
      --ink-soft:#355849;
      --muted:#6f786f;
      --paper:#f5f1e9;
      --paper-2:#fbfaf6;
      --line:#d9d1c5;
      --sage:#dfe8dd;
      --sand:#e9dfcf;
      --deep:#173f31;
      --cream:#fffdf8;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:'Libre Franklin',sans-serif;
      color:var(--ink);
      min-width:320px;
    }
    .display-font{font-family:'Fraunces',serif}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 88% 8%, rgba(219,229,217,.75), transparent 22%),
        radial-gradient(circle at 8% 20%, rgba(255,255,255,.9), transparent 20%),
        linear-gradient(135deg,#f8f5ef 0%,#eee7dc 100%);
    }
    .noise{
      background-image:radial-gradient(rgba(24,60,48,.035) 1px,transparent 1px);
      background-size:18px 18px;
    }
    .focus-ring:focus-visible{outline:3px solid rgba(39,93,73,.28);outline-offset:3px}
    .project-card{transition:transform .3s ease, box-shadow .3s ease}
    .project-card:hover{transform:translateY(-5px);box-shadow:0 24px 50px rgba(25,49,39,.11)}
    .project-card img{transition:transform .55s ease}
    .project-card:hover img{transform:scale(1.035)}
    .nav-link{position:relative}
    .nav-link:after{
      content:"";
      position:absolute;
      left:0;
      bottom:-5px;
      width:100%;
      height:1px;
      background:currentColor;
      transform:scaleX(0);
      transform-origin:right;
      transition:transform .25s ease;
    }
    .nav-link:hover:after{transform:scaleX(1);transform-origin:left}
    .hero-frame:before{
      content:"";
      position:absolute;
      inset:18px -18px -18px 18px;
      border:1px solid rgba(23,63,49,.22);
      z-index:0;
    }
    @media (max-width: 768px){
      .hero-frame:before{inset:12px -10px -10px 12px}
    }
  </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
