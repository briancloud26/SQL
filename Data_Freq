           <div class="grid grid-cols-[1fr_78px] gap-2"><select id="filterColumn" class="query-control"></select> <input id="filterValue" class="query-control" type="text" placeholder="value">
           </div>
          </div>
          <div id="sortWrap">
           <div data-template-id="query-sort-label" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></div>
           <div class="grid grid-cols-[1fr_88px] gap-2"><select id="sortColumn" class="query-control"></select> <select id="sortDirection" class="query-control"> <option>ASC</option> <option>DESC</option> </select>
           </div>
          </div>
          <div id="limitWrap"><label data-template-id="query-limit-label" for="limitInput" class="canva-text block text-xs uppercase tracking-[0.14em] text-[#7f8d84] font-semibold mb-2"></label> <input id="limitInput" class="query-control" type="number" min="1" value="20">
          </div>
          <div class="rounded-2xl bg-[#173b2f] p-4">
           <div class="flex items-center justify-between gap-3 mb-3"><span class="text-xs uppercase tracking-[0.18em] text-white/55 font-semibold">Generated query</span> <button data-template-id="copy-query-button" id="copyQueryBtn" class="canva-button focus-ring inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-medium text-white"><i data-lucide="copy" class="w-3.5 h-3.5"></i></button>
           </div>
           <pre id="queryPreview" class="mono text-[11px] leading-5 whitespace-pre-wrap text-[#dceee4]"></pre>
          </div>
         </div>
        </div>
        <div class="px-5 py-4 border-t border-white/10">
         <p data-template-id="query-footnote" class="canva-text text-xs text-white/55"></p>
        </div>
       </div>
      </aside>
     </section>
    </main>
   </div>
  </div>
  <script src="/_sdk/editing_sdk.js"></script>
  <script>
    lucide.createIcons();

    const sqlPreview = document.getElementById('sqlPreview');
    const queryPreview = document.getElementById('queryPreview');
    const copySqlBtn = document.getElementById('copySqlBtn');
    const copyQueryBtn = document.getElementById('copyQueryBtn');
    const exportBtn = document.getElementById('exportBtn');
    const addTableBtn = document.getElementById('addTableBtn');
    const schemaTab = document.getElementById('schemaTab');
    const queryTab = document.getElementById('queryTab');
    const schemaPane = document.getElementById('schemaPane');
    const queryPane = document.getElementById('queryPane');
    const queryType = document.getElementById('queryType');
    const queryTable = document.getElementById('queryTable');
    const columnChecks = document.getElementById('columnChecks');
    const filterColumn = document.getElementById('filterColumn');
    const filterValue = document.getElementById('filterValue');
    const sortColumn = document.getElementById('sortColumn');
    const sortDirection = document.getElementById('sortDirection');
    const limitInput = document.getElementById('limitInput');
    const columnsWrap = document.getElementById('columnsWrap');
    const sortWrap = document.getElementById('sortWrap');
    const limitWrap = document.getElementById('limitWrap');
    const canvas = document.getElementById('canvas');

    let customCount = 3;
    const dynamicTables = [];

    const schema = {
      users: [
        ['id','UUID PRIMARY KEY'],
        ['full_name','TEXT NOT NULL'],
        ['email','TEXT UNIQUE NOT NULL'],
        ['created_at','TIMESTAMP DEFAULT NOW()']
      ],
      orders: [
        ['id','UUID PRIMARY KEY'],
        ['user_id','UUID REFERENCES users(id)'],
        ['total_amount','INTEGER NOT NULL'],
        ['created_at','TIMESTAMP DEFAULT NOW()']
      ],
      products: [
        ['id','UUID PRIMARY KEY'],
        ['name','TEXT NOT NULL'],
        ['price_cents','INTEGER NOT NULL']
      ]
    };

    function makeSql(){
      const base = Object.entries(schema).map(([table, columns]) => {
        return `CREATE TABLE ${table} (\\n${columns.map(([n,t]) => `  ${n} ${t}`).join(',\\n')}\\n);`;
      }).join('\\n\\n');
      return base + '\\n\\nCREATE INDEX idx_orders_user_id ON orders(user_id);\\nALTER TABLE orders ADD CONSTRAINT orders_total_positive CHECK (total_amount > 0);';
    }

    function renderSql(){
      sqlPreview.textContent = makeSql();
    }

    function setActiveTab(tab){
      const isSchema = tab === 'schema';
      schemaPane.classList.toggle('hidden', !isSchema);
      queryPane.classList.toggle('hidden', isSchema);
      schemaTab.className = 'focus-ring rounded-xl px-3 py-2 text-sm font-semibold ' + (isSchema ? 'tab-active' : 'tab-inactive');
      queryTab.className = 'focus-ring rounded-xl px-3 py-2 text-sm font-semibold ' + (!isSchema ? 'tab-active' : 'tab-inactive');
    }

    function renderColumns(){
      const cols = schema[queryTable.value].map(([name]) => name);
      columnChecks.innerHTML = '';
      filterColumn.innerHTML = '';
      sortColumn.innerHTML = '';
      cols.forEach((col, i) => {
        const id = 'col_' + col;
        const label = document.createElement('label');
        label.className = 'flex items-center gap-2 rounded-lg border border-[#dce7df] px-2.5 py-2 text-xs text-[#315442] bg-white';
        label.innerHTML = `<input type="checkbox" value="${col}" ${i < 3 ? 'checked' : ''} class="accent-[#275642]"> <span>${col}</span>`;
        columnChecks.appendChild(label);

        const opt1 = document.createElement('option');
        opt1.value = col; opt1.textContent = col; filterColumn.appendChild(opt1);
        const opt2 = document.createElement('option');
        opt2.value = col; opt2.textContent = col; sortColumn.appendChild(opt2);
      });
      renderQuery();
    }

    function selectedColumns(){
      return [...columnChecks.querySelectorAll('input:checked')].map(i => i.value);
    }

    function renderQuery(){
      const type = queryType.value;
      const table = queryTable.value;
      const cols = selectedColumns();
      const filterCol = filterColumn.value || schema[table][0][0];
      const filterVal = filterValue.value.trim();
      const where = filterVal ? `\\nWHERE ${filterCol} = '${filterVal.replace(/'/g, "''")}'` : '';

      columnsWrap.classList.toggle('hidden', type === 'delete');
      sortWrap.classList.toggle('hidden', type !== 'select');
      limitWrap.classList.toggle('hidden', type !== 'select');

      let query = '';
      if(type === 'select'){
        query = `SELECT ${cols.length ? cols.join(', ') : '*'}\\nFROM ${table}${where}`;
        if(sortColumn.value) query += `\\nORDER BY ${sortColumn.value} ${sortDirection.value}`;
        if(limitInput.value) query += `\\nLIMIT ${limitInput.value}`;
        query += ';';
      } else if(type === 'insert'){
        const useCols = cols.length ? cols : schema[table].slice(0,2).map(([n]) => n);
        query = `INSERT INTO ${table} (${useCols.join(', ')})\\nVALUES (${useCols.map(() => "'value'").join(', ')});`;
      } else if(type === 'update'){
        const useCols = cols.length ? cols : schema[table].slice(1,2).map(([n]) => n);
        query = `UPDATE ${table}\\nSET ${useCols.map(c => `${c} = 'value'`).join(', ')}${where || `\\nWHERE ${schema[table][0][0]} = 'id'`};`;
      } else {
        query = `DELETE FROM ${table}${where || `\\nWHERE ${schema[table][0][0]} = 'id'`};`;
      }
      queryPreview.textContent = query;
    }

    function copyText(button, text){
      const original = button.innerHTML;
      navigator.clipboard.writeText(text).then(() => {
        button.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Copied</span>';
        lucide.createIcons();
        setTimeout(() => { button.innerHTML = original; lucide.createIcons(); }, 1400);
      }).catch(() => {
        button.innerHTML = '<i data-lucide="x" class="w-4 h-4"></i><span>Failed</span>';
        lucide.createIcons();
        setTimeout(() => { button.innerHTML = original; lucide.createIcons(); }, 1400);
      });
    }

    function createDynamicTable(name){
      const index = dynamicTables.length;
      const x = 360 + (index % 2) * 245;
      const y = 450 + Math.floor(index / 2) * 170;
      dynamicTables.push(name);
      const article = document.createElement('article');
      article.className = 'table-card absolute bg-white rounded-2xl overflow-hidden z-10';
      article.style.left = x + 'px';
      article.style.top = y + 'px';
      article.style.width = '220px';
      article.innerHTML = `
        <div class="px-4 py-3 bg-[#3e705f] text-white flex items-center justify-between">
          <div class="flex items-center gap-2"><span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center"><i data-lucide="table-2" class="w-4 h-4"></i></span><h3 class="font-semibold text-sm">${name}</h3></div>
          <button class="delete-table text-white/80 hover:text-white focus-ring" aria-label="Delete ${name}"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="divide-y divide-[#edf1ed]">
          <div class="px-4 py-3 flex items-center justify-between"><div><div class="text-sm font-semibold text-[#24483a]">id</div><div class="text-[11px] text-[#879189] mt-0.5">UUID</div></div><span class="px-2 py-1 rounded-md bg-[#fff3d8] text-[#9a6d17] text-[10px] font-semibold">PK</span></div>
          <div class="px-4 py-3"><div class="text-sm font-semibold text-[#24483a]">name</div><div class="text-[11px] text-[#879189] mt-0.5">TEXT</div></div>
          <div class="px-4 py-3"><div class="text-sm font-semibold text-[#24483a]">created_at</div><div class="text-[11px] text-[#879189] mt-0.5">TIMESTAMP</div></div>
        </div>`;
      article.querySelector('.delete-table').addEventListener('click', () => article.remove());
      canvas.appendChild(article);
      lucide.createIcons();
    }

    schemaTab.addEventListener('click', () => setActiveTab('schema'));
    queryTab.addEventListener('click', () => setActiveTab('query'));
    queryType.addEventListener('change', renderQuery);
    queryTable.addEventListener('change', renderColumns);
    filterColumn.addEventListener('change', renderQuery);
    filterValue.addEventListener('input', renderQuery);
    sortColumn.addEventListener('change', renderQuery);
    sortDirection.addEventListener('change', renderQuery);
    limitInput.addEventListener('input', renderQuery);
    columnChecks.addEventListener('change', renderQuery);

    copySqlBtn.addEventListener('click', () => copyText(copySqlBtn, sqlPreview.textContent));
    copyQueryBtn.addEventListener('click', () => copyText(copyQueryBtn, queryPreview.textContent));

    exportBtn.addEventListener('click', () => {
      const content = makeSql() + '\\n\\n-- Current query\\n' + queryPreview.textContent;
      const blob = new Blob([content], {type:'text/sql'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'schema-and-query.sql';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    addTableBtn.addEventListener('click', () => {
      customCount += 1;
      createDynamicTable(`table_${customCount}`);
    });

    document.querySelectorAll('.entity-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        customCount += 1;
        createDynamicTable(`${btn.dataset.entity}_${customCount}`);
      });
    });

    document.querySelectorAll('.template-query').forEach(btn => {
      btn.addEventListener('click', () => {
        setActiveTab('query');
        queryType.value = btn.dataset.query;
        renderQuery();
      });
    });

    renderSql();
    renderColumns();
  </script>
